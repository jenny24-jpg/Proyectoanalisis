# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - BACKEND ERP UNIVERSITARIO
# ==============================================================================
# Copia este archivo como '.env' en la raíz de 'server/' y completa los valores.
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración del Servidor Express
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Configuración de Base de Datos Oracle (Módulo de Compras / ERP)
# ------------------------------------------------------------------------------
# Usuario del esquema de base de datos Oracle
DB_USER=ERP_COMPRAS

# Contraseña del usuario Oracle
DB_PASSWORD=tu_password_seguro_aqui

# Cadena de conexión a Oracle (Easy Connect string o TNS Alias)
# Formato: [host]:[port]/[service_name]
# Ejemplos comunes:
#   - Oracle Express Edition (XE): localhost:1521/XEPDB1 o localhost:1521/XE
#   - Oracle Standard / Enterprise: localhost:1521/ORCL o db-server.internal:1521/ORCLPDB
DB_CONNECTION_STRING=localhost:1521/XEPDB1

# ------------------------------------------------------------------------------
# 3. Configuración del Pool de Conexiones (Oracle Connection Pool)
# ------------------------------------------------------------------------------
# Número mínimo de conexiones abiertas en el pool al iniciar
DB_POOL_MIN=2

# Número máximo de conexiones simultáneas permitidas en el pool
DB_POOL_MAX=10

# Cantidad de conexiones a crear cuando se agotan las disponibles y se requiere crecer
DB_POOL_INCREMENT=1

# Tiempo de espera en segundos antes de terminar una conexión inactiva (idle timeout)
DB_POOL_TIMEOUT=60

# Alias identificador único para el pool en memoria de oracledb
DB_POOL_ALIAS=ERP_COMPRAS_POOL
